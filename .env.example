# Copier ce fichier en .env et renseigner les valeurs nécessaires selon le
# backend LLM utilisé. NE JAMAIS committer le fichier .env réel (clés secrètes).

# --- Mode de génération LLM ---
# Valeurs possibles : mock (défaut, sans rien) / ollama (local, sans clé API) /
# dataiku (LLM Mesh, à exécuter dans Dataiku)
LLM_MODE=mock

# --- Backend "ollama" (Llama en local, via https://ollama.com — gratuit, sans clé API) ---
# Prérequis : installer Ollama, puis télécharger un modèle :
#   ollama pull llama3.2:3b   (~2 Go, bon compromis qualité/vitesse)
#   ollama pull llama3.2:1b   (~1.3 Go, machine plus modeste)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT=300

# --- Backend "dataiku" (appel via LLM Mesh, à exécuter dans Dataiku) ---
# Identifiant du LLM configuré dans le projet Dataiku (LLM Mesh)
DATAIKU_LLM_ID=
